<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fpt.framework</groupId>
        <artifactId>turbo-parent</artifactId>
        <version>1.2.8-SNAPSHOT</version>
    </parent>

    <groupId>com.swork</groupId>
    <artifactId>swork-backend</artifactId>
    <version>1.2.8-SNAPSHOT</version>
    <name>swork-backend</name>
    <description>sWork Backend Service - Reactive Spring Boot &amp; MongoDB with Turbo Boot</description>

    <repositories>
        <repository>
            <id>gitlab-fpt</id>
            <url>https://gitlab.fis.vn/api/v4/projects/5486/packages/maven</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Turbo Boot Web API (Spring WebFlux, OpenAPI Swagger WebFlux, Validation) -->
        <dependency>
            <groupId>com.fpt.framework</groupId>
            <artifactId>turbo-web-api</artifactId>
        </dependency>

        <!-- Turbo Boot Data (Reactive MongoDB, ReactiveNoneRelationTemplate, BaseDocument) -->
        <dependency>
            <groupId>com.fpt.framework</groupId>
            <artifactId>turbo-data</artifactId>
        </dependency>

        <!-- Turbo Utility -->
        <dependency>
            <groupId>com.fpt.framework</groupId>
            <artifactId>turbo-utility</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${springboot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <version>3.6.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${springboot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
